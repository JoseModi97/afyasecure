# AfyaSecure Environment Configuration

# PostgreSQL Connection String (Neon, Supabase, or local Docker)
DATABASE_URL="postgresql://afyasecure:afyasecure_secret_password@localhost:5432/afyasecure_db"

# Cloudflare Configuration (Required for CI/CD Cloudflare deployment)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Application Environment
NODE_ENV="development"
DATA_PROTECTION_ACT_VERSION="Kenya-DPA-2019"
